// WholesaleHub Ethiopia - Prisma Schema
// Database configuration for PostgreSQL (Neon / Managed Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

