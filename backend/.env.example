# WholesaleHub Ethiopia - Backend Environment Configuration

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Neon / Local)
DATABASE_URL=postgresql://username:password@localhost:5432/wholesalehub_dev?schema=public

# Authentication Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars_long
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Regional Configuration
DEFAULT_CURRENCY=ETB
DEFAULT_TIMEZONE=Africa/Addis_Ababa
